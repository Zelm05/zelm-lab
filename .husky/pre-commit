#!/bin/sh
# 预提交钩子（2026-09-24 第二次修）
# 为什么不用 `npm test`：Node 安装目录里的 `npm` 是 `#!/usr/bin/env bash` 的 sh 包装脚本，
#   而 GitHub Desktop 的运行环境没有 bash（它自带的 git 只有 sh.exe，PATH 里也没有 Git 的 usr/bin），
#   一跑就报 `/usr/bin/env: bash: No such file or directory` → 提交被中止。
#   这里直接用 node 跑 vitest 入口，绕开 npm 包装；任一项不可用就跳过（质量门禁由 CI 兜底）。
if [ -d node_modules ] && command -v node >/dev/null 2>&1 && [ -f node_modules/vitest/vitest.mjs ]; then
  node node_modules/vitest/vitest.mjs run || exit 1
else
  echo "husky: pre-commit skipped (node / node_modules / vitest unavailable) - CI runs the full suite"
fi
